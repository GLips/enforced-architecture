// ─── boundary/env-access ─────────────────────────────────────────────
//
// Tag:      boundary
// Mechanism: GritQL (per-file, real-time)
// Blocking: Yes
//
// Prevents: Any module other than the env module reading process.env
//           (or import.meta.env) directly.
//
// Applies:  All src/** files EXCEPT the env module itself and tests.
//
// ── Adapt ─────────────────────────────────────────────────────────────
//
// 1. The owning module (the exclusion line). One file, named exactly.
//    Projects that split client and server env exclude both:
//      ! $filename <: r".*/src/env\.(?:client|server)\.ts$",
//
// 2. The access form. This template matches `process.env`. Add
//    `import.meta.env` as a second arm for Vite-family projects; for a
//    project using only import.meta.env, swap it in.
//
// 3. Build-time config files (vite.config.ts, app.config.ts, next.config.js)
//    sit outside src/ and are unaffected. That is deliberate: what the
//    BUILD reads is a different question from what a RUNNING app
//    believes, and conflating them forces an exemption that then gets
//    reused for runtime code.
//
// ──────────────────────────────────────────────────────────────────────

file(name=$filename, body=$program) where {
    $filename <: r".*/src/.*",

    // --- The one module allowed to read env ---
    ! $filename <: r".*/src/env\.ts$",

    // --- Global exclusions (shared across all rules) ---
    ! $filename <: r".*\.test\.[tj]sx?$|.*\.integration\.test\.[tj]sx?$|.*__tests__.*|.*src/test/.*",
    ! $filename <: r".*/scripts/.*",

    $program <: contains bubble or {
        `process.env`,
        `process[$key]` where { $key <: r"[\"']env[\"']" },
        `globalThis.process.env`,
        `import.meta.env`,
        `const { env } = process`,
        JsImport() as $import where {
            $import <: r"(?s)import\s*\{[^}]*\benv\b[^}]*\}\s*from\s*[\"']node:process[\"'];?"
        }
    } as $access where {
        register_diagnostic(
            span = $access,
            message = "Only the env module reads environment variables. Import its validated config and add the variable there."
        )
    }
}
