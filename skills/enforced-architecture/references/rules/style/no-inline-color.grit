// ─── style/no-inline-color ────────────────────────────────────────────
//
// Tag:      style
// Mechanism: GritQL (per-file, real-time)
// Blocking: Yes
//
// Prevents: Raw color values written into style objects or color props —
//           hex literals (`#0a0c10`), and `rgb()` / `rgba()` / `hsl()` /
//           `hsla()` with literal channels.
//
//           Color is the axis where drift is both easiest and least
//           visible. A model reaches for a plausible gray fluently, and
//           the result looks fine in the scheme it was written against
//           and wrong in the other one. Routing every color through the
//           token table is also what makes dark mode true by
//           construction: the token holds both schemes, so there is no
//           second variant for a model to forget, and the bug stops
//           being expressible.
//
// Applies:  All source files EXCEPT:
//           - The token source itself (it defines the raw values)
//           - Non-UI layers with no styling (domains, pure logic)
//           - Test files and scripts
//           - Documented raster/canvas boundaries (see Adapt section 3)
//
//           NOT `.css` files — Biome's GritQL plugins run on the JS/TS
//           AST only. The stylesheet surface is covered by the
//           `style/css-tokens` structural check.
//
// Error:    "Raw color value. Use a color token so light and dark stay
//            in sync."
//
// ── Adapt ─────────────────────────────────────────────────────────────
//
// 1. Token reference syntax (the message):
//    Name the exact shape a fix takes in your project, because the
//    message is the only documentation an agent reliably reads:
//      - CSS variables:  `var(--app-bg-raised)`
//      - Theme object:   `theme.colors.backgroundRaised` (Unistyles,
//                        styled-components, Tamagui)
//      - Component prop: `c="dimmed"` (Mantine), `color="text-primary"`
//                        (a closed union on your own primitive)
//    Replace the examples in the message with yours.
//
// 2. Color-carrying prop names (the `jsx_attribute` arm):
//    The default set is `c` / `bg` / `color`. This arm exists so that
//    `<Text color="#fff">` is caught alongside `{ color: "#fff" }`. Keep
//    the set SMALL and exact — matching every attribute would flag
//    `href="#anchor"` and fragment ids. Add your primitives' color props
//    (`tint`, `borderColor`, `backgroundColor`) if they accept strings.
//
//    If your primitives type these props as a closed union of token
//    names, the type system already rejects a hex — this arm is then
//    belt-and-braces for the props that stayed open. That is the correct
//    division: types own the closed props, this rule owns the leaks.
//
// 3. Exemptions:
//    - The token source file (`theme.ts`, `tokens.ts`) MUST be exempt.
//    - Canvas / raster / native-module boundaries take literal colors by
//      API contract (an xterm.js theme, a Skia paint, a status-bar
//      color). Exempt by path with a comment, and derive the literal
//      from the token in that file.
//    - Non-UI layers (`src/domains/`) are exempt only because they
//      should carry no styling at all; if yours can, drop the line.
//
// 4. What this rule deliberately does NOT do:
//    It does not check that a `var(--x)` / `theme.colors.x` reference
//    names a real token. That needs the token source, which a per-file
//    linter cannot import — see `style/token-equality` for the tier that
//    can.
//
// ──────────────────────────────────────────────────────────────────────

language js(typescript, jsx)

// A string containing a hex literal or a color function with a literal channel.
// The digit requirement in the function forms is what lets `rgb(var(--x))` pass.
// Grit regexes are anchored, so the pattern spans the whole string node.
pattern raw_color_value() {
    r"\"[^\"]*(?:#[0-9a-fA-F]{3,8}\b|(?:rgb|rgba|hsl|hsla)\([^)]*[0-9])[^\"]*\""
}

file(name=$filename, body=$program) where {
    // --- Global exclusions (shared across all rules) ---
    ! $filename <: r".*\.test\.[tj]sx?$|.*\.integration\.test\.[tj]sx?$|.*__tests__.*|.*src/test/.*",
    ! $filename <: r".*/scripts/.*",

    // --- Token source: defines the raw values by design (Adapt 3) ---
    ! $filename <: r".*/src/shared/ui/theme\.ts$",

    // --- Non-UI layers carry no styling (Adapt 3) ---
    ! $filename <: r".*/src/domains/.*",

    $program <: contains bubble or {
        // Style-object values: `{ color: "#fff" }`, `{ backgroundColor: "rgb(0,0,0)" }`.
        // Covers inline `style={{}}`, StyleSheet.create objects, and theme-adjacent
        // literals alike — they are all the same object-property shape.
        `$key: $value` where { $value <: raw_color_value() },

        // Color props on components: `<Text c="#fff">` (Adapt 2).
        jsx_attribute() as $attr where {
            $attr <: r"^(?:c|bg|color)=\"[^\"]*(?:#[0-9a-fA-F]{3,8}\b|(?:rgb|rgba|hsl|hsla)\([^)]*[0-9])[^\"]*\"$"
        }
    } as $match where {
        register_diagnostic(
            span = $match,
            message = "Raw color value. Use a color token instead — `var(--app-text-secondary)`, `theme.colors.textSecondary`, or a closed color prop on the primitive (`c='dimmed'`). Tokens carry both schemes, so light and dark stay in sync and there is no dark variant to forget. See docs/architecture/design-system.md."
        )
    }
}
