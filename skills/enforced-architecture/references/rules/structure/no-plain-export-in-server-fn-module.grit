// ─── structure/no-plain-export-in-server-fn-module ────────────────────
//
// Tag:      structure
// Mechanism: GritQL (per-file, real-time)
// Blocking: Yes
//
// Prevents: Runtime exports other than compiler bridges in a non-server
//           module that defines createServerFn or createMiddleware.
//           Client compilation replaces server-function handlers and strips
//           middleware .server() and .validator() calls; it does not
//           erase sibling runtime exports.
//
// Allows:   Type-only exports, exported createServerFn/createMiddleware
//           bridges, and module-private helpers.
//
// Fix:      Move server-only runtime exports to a .server.ts sibling. Move
//           client-safe exports to their own module.
//
// Source:   @tanstack/start-plugin-core/src/start-compiler/
//           handleCreateServerFn.ts, handleCreateMiddleware.ts
//
// Applies:  Non-.server source files containing createServerFn or
//           createMiddleware calls. Excludes tests and scripts.
//
// Negative space: This rule does not detect top-level side effects or prove
//                 client reachability. Cross-file safety belongs to the
//                 client-boundary graph checks.
//
//                 The bridge exemption matches the initializer textually, so
//                 it rejects `export const fn: T = createServerFn()` and other
//                 forms the compiler unwraps (parens, `satisfies`, non-null).
//                 Deliberate: a structural `contains` would wrongly exempt
//                 `export const helper = () => createServerFn()`, which leaks.
//
// ── Adapt ─────────────────────────────────────────────────────────────
//
// 1. Replace the factory names for frameworks with equivalent compiler
//    bridges.
//
// 2. Update the .server exclusion when the project uses a different hard
//    server-only fence.
//
// ──────────────────────────────────────────────────────────────────────

file(name=$filename, body=$program) where {
    ! $filename <: r".*\.test\.[tj]sx?$|.*\.integration\.test\.[tj]sx?$|.*__tests__.*|.*src/test/.*",
    ! $filename <: r".*/scripts/.*",
    ! $filename <: r".*\.server\.[tj]sx?$",

    or {
        $program <: contains `createServerFn($_)`,
        $program <: contains `createMiddleware($_)`
    },

    $program <: contains bubble or {
            // Biome's GritQL does not parse `export default $expression` as a
            // snippet; the node name is the only spelling that matches. The
            // named `export default function` and `class` snippets below do work.
            JsExportDefaultExpressionClause(),
            `export const $name = $value`,
            `export let $name = $value`,
            `export var $name = $value`,
            `export let $name`,
            `export var $name`,
            `export function $name($_args): $_ret { $... }`,
            `export async function $name($_args): $_ret { $... }`,
            `export function $name($_args) { $... }`,
            `export async function $name($_args) { $... }`,
            `export class $name { $... }`,
            `export class $name extends $_base { $... }`,
            `export enum $name { $... }`,
            `export default function $name($_args): $_ret { $... }`,
            `export default async function $name($_args): $_ret { $... }`,
            `export default function $name($_args) { $... }`,
            `export default async function $name($_args) { $... }`,
            `export default class $name { $... }`,
            `export default class $name extends $_base { $... }`,
            `export { $name as $alias }`,
            `export { $name } from $_source`,
            `export { $name as $alias } from $_source`,
            `export * from $_source`,
            `export * as $name from $_source`,
            JsExportNamedClause()
        } as $leak where {
            ! $leak <: r"(?s)export\s+const\s+[A-Za-z_$][A-Za-z0-9_$]*\s*=\s*createServerFn\s*\(.*",
            ! $leak <: r"(?s)export\s+const\s+[A-Za-z_$][A-Za-z0-9_$]*\s*=\s*createMiddleware\s*\(.*",
            ! $leak <: r"(?s)type\s.*",
            ! $leak <: r"(?s)\{\s*type\s+[^,}]+(?:,\s*type\s+[^,}]+)*,?\s*\}\s*;?",
            ! $leak <: r"(?s)export\s*\{\s*type\s+[^,}]+(?:,\s*type\s+[^,}]+)*,?\s*\}\s*from\s+.*",
            register_diagnostic(
                span = $leak,
                message = "Only createServerFn/createMiddleware bridges and types may be exported from a compiler-processed module. Move this runtime export to a client-safe or .server.ts sibling."
            )
        }
}
