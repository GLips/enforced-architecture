// ─── structure/no-deprecated-input-validator ──────────────────────────
//
// Tag:      structure
// Mechanism: GritQL (per-file, real-time)
// Blocking: Yes
//
// Prevents: Deprecated `.inputValidator()` calls on TanStack Start server
//           functions and middleware. Use `.validator()` instead.
//
// Applies:  All src/** files except tests and scripts.
//
// Source: @tanstack/start-plugin-core/src/start-compiler/handleCreateServerFn.ts
//         and handleCreateMiddleware.ts.
//
// ──────────────────────────────────────────────────────────────────────

file(name=$filename, body=$program) where {
    ! $filename <: r".*\.test\.[tj]sx?$|.*\.integration\.test\.[tj]sx?$|.*__tests__.*|.*src/test/.*",
    ! $filename <: r".*/scripts/.*",

    $program <: contains bubble `$builder.inputValidator($_)` as $call where {
        or {
            $builder <: contains `createServerFn($_)`,
            $builder <: contains `createMiddleware($_)`
        },
        register_diagnostic(
            span = $call,
            message = ".inputValidator() is deprecated in TanStack Start. Use .validator() instead."
        )
    }
}
