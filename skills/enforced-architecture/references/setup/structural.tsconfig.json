// Copy to `lint/structural/tsconfig.json`. Its options are identical to
// `oxlint.tsconfig.json`'s, and it is still a SEPARATE program: each tier is
// copied into an adopting project as a directory that has to typecheck on its
// own, and a single program spanning both would typecheck neither when only one
// is present. The two used to differ on `types` as well — the structural tier
// ran under Bun — and they no longer do; both tiers run under Node.
//
// `allowImportingTsExtensions` is required, not stylistic: every check imports
// its neighbours with the `.ts` extension because Node loads these files
// directly, with no build step to rewrite a specifier.
//
// Add it to the typecheck script explicitly — `tsc --noEmit -p lint/structural`
// — because a program nothing runs is a program that goes stale silently.
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "lib": ["ESNext"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true
  },
  // Three entries, and the third is the one projects forget. `arch.config.ts`
  // imports the project's own theme module so `style/token-equality` compares
  // against the real scale — that import reaches out of this directory, and the
  // program has to follow it or the config typechecks against nothing.
  "include": ["**/*.ts", "../policy/**/*.ts", "../../src/shared/ui/theme.ts"]
}
