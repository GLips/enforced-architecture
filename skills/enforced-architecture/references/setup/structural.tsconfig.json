// Copy to `lint/structural/tsconfig.json`. The structural tier runs under Bun,
// so it takes `types: ["bun"]` where the oxlint tier takes `["node"]` — that
// difference is the whole reason the two tiers are separate programs.
//
// `allowImportingTsExtensions` is required, not stylistic: every check imports
// its neighbours with the `.ts` extension because Bun loads these files
// directly at runtime, with no build step to rewrite a specifier.
//
// Add it to the typecheck script explicitly — `tsc --noEmit -p lint/structural`
// — because a program nothing runs is a program that goes stale silently.
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "lib": ["ESNext"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "types": ["bun"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true
  },
  // Three entries, and the third is the one projects forget. `arch.config.ts`
  // imports the project's own theme module so `style/token-equality` compares
  // against the real scale — that import reaches out of this directory, and the
  // program has to follow it or the config typechecks against nothing.
  "include": ["**/*.ts", "../policy/**/*.ts", "../../src/shared/ui/theme.ts"]
}
